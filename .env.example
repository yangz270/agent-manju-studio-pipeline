# =====================================================================
# AI Donghua Studio - Configuration Template
# 使用前必读：
#   1) 复制本文件为 .env          ->  cp .env.example .env
#   2) 填入你自己的商业 API Key   ->  标 [必需] 的三项缺一不可
#   3) 启动前自检                  ->  python scripts/preflight_check.py
# 注意：.env 已被 .gitignore 忽略，绝不要把真实密钥提交到仓库。
# =====================================================================

# ---------------------------------------------------------------------
# [必需] DeepSeek API Key —— Agent 1/2 编剧脱水与 0-3s 黄金 Hook 审查
# 申请: https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------------------------------------------------------------------
# [必需] MiniMax API Key —— Agent 6/7 拟真情感配音与海螺视频
# 申请: https://platform.minimaxi.com/user-center/basic-information/interface-key
# ---------------------------------------------------------------------
MINIMAX_API_KEY=your_minimax_api_key_here

# ---------------------------------------------------------------------
# [必需] OpenAI 兼容网关 Key —— Agent 5 四维审美质检（GPT-4o Vision）
# 可用 302.AI 等聚合网关，把 OPENAI_BASE_URL 指向对应 /v1 端点
# ---------------------------------------------------------------------
OPENAI_API_KEY=your_openai_or_302ai_key_here
OPENAI_BASE_URL=https://api.302.ai/v1

# ---------------------------------------------------------------------
# [可选] 阿里云百炼 DashScope —— Qwen-VL-Plus 视觉审图备份通道
# ---------------------------------------------------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------------------------------------------------------------
# [可选] Moonshot Kimi —— 2M 上下文长篇原著扫描
# ---------------------------------------------------------------------
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ---------------------------------------------------------------------
# [可选] 本地环境路径（不填则用默认值，不会泄露任何个人信息）
# ---------------------------------------------------------------------
# ComfyUI 安装根目录，用于节点/模型目录预检
COMFYUI_ROOT_DIR=./ComfyUI
# ComfyUI HTTP 服务地址
COMFYUI_SERVER=http://127.0.0.1:8188
# 剪映草稿库路径（留空则自动探测）
JIANYING_DRAFT_DIR=

# ---------------------------------------------------------------------
# [安全] 付费 API 自动授权开关
# 默认 false：每次调用付费接口前都会弹人工确认，绝不暗箱扣费。
# 仅在完全信任当前任务时改为 true。
# ---------------------------------------------------------------------
AUTO_APPROVE_ALL_KEYS=false
